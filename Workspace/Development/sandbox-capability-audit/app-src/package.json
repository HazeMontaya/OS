{
  "name": "os-ai-operating-system",
  "productName": "OS",
  "version": "0.6.0",
  "description": "OS autonomous capability fabric and self-development system",
  "main": "main.js",
  "private": true,
  "scripts": {
    "test": "node tests/smoke.js",
    "start": "electron .",
    "build": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.os.desktop",
    "productName": "OS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "capability-fabric.js",
      "dev-pipeline.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir"
    }
  }
}