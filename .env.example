# JAMES OS model configuration
# none = deterministic/runtime-only mode (default)
# omniroute = local OmniRoute gateway
# ollama/vllm/llamacpp/lmstudio = local OpenAI-compatible server
OS_MODEL_PROVIDER=none
OS_MODEL=default
# Example local endpoints:
# OS_MODEL_ENDPOINT=http://127.0.0.1:20128/v1/chat/completions
# OS_MODEL_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
# OS_MODEL_API_KEY_ENV=OMNIROUTE_API_KEY

# Runtime
OS_INITIAL_BALANCE_CENTS=0
OS_HEARTBEAT_SECONDS=2
OS_WORKSPACE_ROOT=workspaces

# Dashboard
OS_DASHBOARD_HOST=127.0.0.1
OS_DASHBOARD_PORT=8787
