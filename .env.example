# OS local runtime defaults
# The Windows launcher supplies these automatically unless you override them.

OS_LLAMA_SERVER=http://127.0.0.1:11434
OS_LLAMA_MODEL=llama3.2:3b
OS_EMBED_SERVER=http://127.0.0.1:11434
OS_EMBED_MODEL=nomic-embed-text

# Optional bearer tokens for custom OpenAI-compatible local endpoints.
OS_LLAMA_API_KEY=
OS_EMBED_API_KEY=

# Optional cloud providers. Never commit real credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
