# OS local runtime defaults
# Copy values into your environment only when overriding the automatic local runtime.

# OpenAI-compatible local model server. The Windows launcher defaults to Ollama.
OS_LLAMA_SERVER=http://127.0.0.1:11434
OS_LLAMA_MODEL=llama3.2:3b

# Embeddings can use a separate local model/server.
OS_EMBED_SERVER=http://127.0.0.1:11434
OS_EMBED_MODEL=nomic-embed-text

# Optional bearer tokens for custom OpenAI-compatible local endpoints.
OS_LLAMA_API_KEY=
OS_EMBED_API_KEY=

# Optional cloud providers. Keep real values out of Git.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
